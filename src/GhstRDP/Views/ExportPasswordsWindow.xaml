<Window x:Class="GhstRDP.Views.ExportPasswordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GhstRDP.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ExportPasswordsViewModel}"
        Style="{StaticResource WindowBase}"
        Title="Exportar senhas"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary Source="TransferTemplates.xaml" />
    </Window.Resources>

    <Border Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <Grid Height="52">
                <TextBlock Text="Exportar senhas" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,4,0,0" />
                <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" AutomationProperties.Name="Fechar" />
            </Grid>

            <StackPanel Margin="24,4,24,16">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="O que exportar" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn.Link}" Content="Marcar tudo" FontSize="12" Click="SelectAll_Click" Margin="0,0,14,0" />
                        <Button Style="{StaticResource Btn.Link}" Content="Desmarcar tudo" FontSize="12" Click="SelectNone_Click" />
                    </StackPanel>
                </Grid>

                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14,12,6,2">
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource TransferGroupTemplate}" Margin="0,0,8,0" />
                    </ScrollViewer>
                </Border>

                <TextBlock Text="Formato" Style="{StaticResource Text.Label}" Margin="0,18,0,8" />
                <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="format" Content="Código para importar"
                                     IsChecked="{Binding Format, Converter={StaticResource EnumBool}, ConverterParameter=Code}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="format" Content="Texto para Discord"
                                     IsChecked="{Binding Format, Converter={StaticResource EnumBool}, ConverterParameter=Markdown}" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Text.Caption}" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                               Text="O código sai criptografado. Quem receber importa pelo Ghst RDP usando esta senha; mande a senha por outro canal." />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Senha do código" Style="{StaticResource Text.Label}" />
                            <PasswordBox x:Name="CodePasswordBox" PasswordChanged="CodePassword_Changed" AutomationProperties.Name="Senha do código" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Repita a senha" Style="{StaticResource Text.Label}" />
                            <PasswordBox x:Name="CodePasswordConfirmBox" PasswordChanged="CodePassword_Changed" AutomationProperties.Name="Repita a senha" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Caption}" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                           Visibility="{Binding IsCode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                           Text="Texto pronto para colar no Discord: endereços e senhas ficam em spoiler. Qualquer pessoa que vir a mensagem consegue ler, então cole só em lugar privado." />
            </StackPanel>

            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding Error, Converter={StaticResource TextToVis}}" />
                    <Grid>
                        <TextBlock Text="{Binding Footer}" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                            <Button Style="{StaticResource Btn.Primary}" Content="Copiar" MinWidth="96" IsDefault="True" Click="Copy_Click" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="Salvar arquivo…" Click="Save_Click" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="Fechar" MinWidth="80" IsCancel="True" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
