<Window x:Class="GhstRDP.Views.VaultEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GhstRDP.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:VaultEntryEditViewModel}"
        Style="{StaticResource WindowBase}"
        Title="{Binding Title}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <Grid Height="52">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,4,0,0" />
                <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click" AutomationProperties.Name="Fechar" />
            </Grid>

            <StackPanel Margin="24,4,24,10">
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="Máquina" Style="{StaticResource Text.Label}" />
                    <ComboBox ItemsSource="{Binding Machines}" SelectedItem="{Binding SelectedMachine}" DisplayMemberPath="Name" MinWidth="0" />
                    <TextBox Text="{Binding MachineName, UpdateSourceTrigger=PropertyChanged}" Tag="Nome da máquina" Margin="0,8,0,0"
                             Visibility="{Binding IsOtherMachine, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="Rótulo" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="LabelBox" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: Admin, SQL Server, Painel" />
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="Usuário" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                        <TextBlock Text="Senha" Style="{StaticResource Text.Label}" />
                        <Grid>
                            <PasswordBox x:Name="PasswordInput" Padding="10,7,38,7" PasswordChanged="PasswordInput_PasswordChanged" />
                            <TextBox x:Name="PasswordPlain" Padding="10,7,38,7" Visibility="Collapsed"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                            <Button x:Name="RevealButton" Style="{StaticResource Btn.Icon}" Width="28" Height="26" Margin="0,0,3,0"
                                    HorizontalAlignment="Right" Content="&#xE7B3;" Click="Reveal_Click" ToolTip="Mostrar senha" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Style="{StaticResource Field}" Margin="0,0,0,6">
                    <TextBlock Text="Observações (opcional)" Style="{StaticResource Text.Label}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="60" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding Error, Converter={StaticResource TextToVis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn.Primary}" Content="Salvar" MinWidth="96" IsDefault="True" Click="Save_Click" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Btn.Secondary}" Content="Cancelar" MinWidth="96" IsCancel="True" Click="Cancel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
