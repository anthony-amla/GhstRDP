<Window x:Class="GhstRDP.Views.EditServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GhstRDP.ViewModels"
        xmlns:core="clr-namespace:GhstRDP.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EditServerViewModel}"
        Style="{StaticResource WindowBase}"
        Title="{Binding Title}"
        Width="560" Height="720" MinHeight="460" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="5" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="Group" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
            <Setter Property="Margin" Value="0,10,0,12" />
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,4,0,0" />
                <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click" AutomationProperties.Name="Fechar" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,4,16,8">
                <StackPanel Margin="0,0,8,0">

                    <StackPanel Style="{StaticResource Field}">
                        <TextBlock Text="Nome" Style="{StaticResource Text.Label}" />
                        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: VPS 01" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Endereço (IP ou domínio)" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                            <TextBlock Text="Porta" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Usuário" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                            <TextBlock Text="Senha" Style="{StaticResource Text.Label}" />
                            <Grid>
                                <PasswordBox x:Name="PasswordInput" Padding="10,6,38,6" PasswordChanged="PasswordInput_PasswordChanged" />
                                <TextBox x:Name="PasswordPlain" Padding="10,6,38,6" Visibility="Collapsed"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                                <Button x:Name="RevealButton" Style="{StaticResource Btn.Icon}" Width="28" Height="26" Margin="0,0,3,0"
                                        HorizontalAlignment="Right" Content="&#xE7B3;" Click="Reveal_Click" ToolTip="Mostrar senha" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Tipo" Style="{StaticResource Text.Label}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Kind}" MinWidth="0">
                                <ComboBoxItem Content="VPS" Tag="{x:Static core:ServerKind.Vps}" />
                                <ComboBoxItem Content="Dedicado" Tag="{x:Static core:ServerKind.Dedicated}" />
                                <ComboBoxItem Content="Outro" Tag="{x:Static core:ServerKind.Other}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                            <TextBlock Text="Cliente / empresa (opcional)" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Tag="Ex.: Empresa A, Cliente B" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Favorito" IsChecked="{Binding Favorite}" Margin="0,2,0,6" />

                    <TextBlock Text="Banner do card" Style="{StaticResource Group}" Margin="0,18,0,12" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="200" Height="100" CornerRadius="6" Background="{StaticResource ThumbBrush}" VerticalAlignment="Top">
                            <Grid>
                                <TextBlock Text="Sem banner" Foreground="{StaticResource TextTertiaryBrush}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <Image Source="{Binding BannerPreview}" Stretch="Uniform" Margin="16,12" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding ShowPreviewLogo, Converter={StaticResource BoolToVis}}" />
                                <Border CornerRadius="6" Visibility="{Binding ShowPreviewFill, Converter={StaticResource BoolToVis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding BannerPreview}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource Btn.Secondary}" Content="Escolher imagem…" Command="{Binding ChooseBannerCommand}" />
                                <Button Style="{StaticResource Btn.Subtle}" Content="Remover" Margin="6,0,0,0" Command="{Binding RemoveBannerCommand}"
                                        Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Text="Coloque a logo da empresa. Sem banner, o card mostra a última tela da sessão."
                                       Style="{StaticResource Text.Caption}"
                                       Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <CheckBox Content="Cobrir o card todo" IsChecked="{Binding BannerFill}"
                                      Visibility="{Binding CanChooseFill, Converter={StaticResource BoolToVis}}" />
                            <CheckBox IsChecked="{Binding ApplyBannerToClient}" Margin="0,0,0,0"
                                      Visibility="{Binding CanApplyToClient, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ApplyToClientText}" TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Conexão" Style="{StaticResource Group}" Margin="0,18,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Abrir" Style="{StaticResource Text.Label}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding OpenMode}" MinWidth="0">
                                <ComboBoxItem Content="{Binding AppDefaultLabel}" Tag="{x:Static core:OpenMode.Default}" />
                                <ComboBoxItem Content="No Ghst, em aba" Tag="{x:Static core:OpenMode.Embedded}" />
                                <ComboBoxItem Content="No mstsc" Tag="{x:Static core:OpenMode.External}" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                            <TextBlock Text="Tela" Style="{StaticResource Text.Label}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Display}" MinWidth="0">
                                <ComboBoxItem Content="Ajustar à janela" Tag="{x:Static core:DisplayMode.FitWindow}" />
                                <ComboBoxItem Content="Tela cheia" Tag="{x:Static core:DisplayMode.FullScreen}" />
                                <ComboBoxItem Content="Resolução fixa" Tag="{x:Static core:DisplayMode.Custom}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" HorizontalAlignment="Right"
                                Visibility="{Binding IsCustomDisplay, Converter={StaticResource BoolToVis}}">
                        <TextBox Width="80" Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="×" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Width="80" Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Text="Domínio (opcional)" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Style="{StaticResource Field}">
                            <TextBlock Text="Áudio" Style="{StaticResource Text.Label}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Audio}" MinWidth="0">
                                <ComboBoxItem Content="Tocar neste PC" Tag="{x:Static core:AudioMode.Local}" />
                                <ComboBoxItem Content="Tocar no servidor" Tag="{x:Static core:AudioMode.Remote}" />
                                <ComboBoxItem Content="Sem áudio" Tag="{x:Static core:AudioMode.Off}" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="Área de transferência (copiar e colar)" IsChecked="{Binding RedirectClipboard}" />
                    <CheckBox Content="Discos deste PC" IsChecked="{Binding RedirectDrives}" />
                    <CheckBox Content="Impressoras" IsChecked="{Binding RedirectPrinters}" />
                    <CheckBox Content="Usar todos os monitores" IsChecked="{Binding Multimon}" />
                    <CheckBox Content="Sessão de console (/admin)" IsChecked="{Binding AdminSession}" />

                    <StackPanel Style="{StaticResource Field}" Margin="0,8,0,4">
                        <TextBlock Text="Observações" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="72" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding Error, Converter={StaticResource TextToVis}}" />
                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Secondary}" Content="Testar porta" Command="{Binding TestCommand}" />
                            <TextBlock Text="{Binding TestResult}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                       MaxWidth="170" TextTrimming="CharacterEllipsis" ToolTip="{Binding TestResult}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestOk}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn.Primary}" Content="Salvar" MinWidth="96" IsDefault="True" Click="Save_Click" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Secondary}" Content="Cancelar" MinWidth="96" IsCancel="True" Click="Cancel_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
