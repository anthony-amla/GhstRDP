<Window x:Class="GhstRDP.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowBase}"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Title="Ghst RDP">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <StackPanel Margin="24,22,24,24">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,10,0,0" LineHeight="19" />
            </StackPanel>

            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                <UniformGrid x:Name="ButtonsGrid" Rows="1" HorizontalAlignment="Stretch">
                    <Button x:Name="PrimaryButton" Style="{StaticResource Btn.Primary}" Margin="0,0,4,0" IsDefault="True" Click="Primary_Click" />
                    <Button x:Name="SecondaryButton" Style="{StaticResource Btn.Secondary}" Margin="4,0,0,0" IsCancel="True" Click="Secondary_Click" />
                </UniformGrid>
            </Border>
        </StackPanel>
    </Border>
</Window>
