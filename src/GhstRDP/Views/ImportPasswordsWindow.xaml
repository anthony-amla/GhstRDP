<Window x:Class="GhstRDP.Views.ImportPasswordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GhstRDP.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ImportPasswordsViewModel}"
        Style="{StaticResource WindowBase}"
        Title="Importar senhas"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary Source="TransferTemplates.xaml" />
    </Window.Resources>

    <Border Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <Grid Height="52">
                <TextBlock Text="Importar senhas" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,4,0,0" />
                <Button Style="{StaticResource Btn.CaptionClose}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Cancel_Click" AutomationProperties.Name="Fechar" />
            </Grid>

            <StackPanel Margin="24,4,24,16" Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource Text.Caption}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Cole o código que alguém exportou no Ghst RDP, ou abra o arquivo .ghstrdp. Você escolhe o que importar antes de salvar." />
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Código" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0" />
                    <Button Style="{StaticResource Btn.Link}" Content="Abrir arquivo…" FontSize="12" HorizontalAlignment="Right" Click="OpenFile_Click" />
                </Grid>
                <TextBox x:Name="CodeBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         TextWrapping="Wrap" AcceptsReturn="True" Height="110" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         Tag="GHSTRDP1.…" AutomationProperties.Name="Código" />
                <TextBlock Text="Senha do código" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                <PasswordBox x:Name="CodePasswordBox" PasswordChanged="CodePassword_Changed" KeyDown="CodePassword_KeyDown"
                             AutomationProperties.Name="Senha do código" />
            </StackPanel>

            <StackPanel Margin="24,4,24,16" Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" FontSize="13" VerticalAlignment="Center" />
                </Grid>
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="14,12,6,2">
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource TransferGroupTemplate}" Margin="0,0,8,0" />
                    </ScrollViewer>
                </Border>
                <CheckBox IsChecked="{Binding ReplaceExisting}" Margin="0,16,0,0">
                    <TextBlock TextWrapping="Wrap"
                               Text="Substituir o que já existe aqui (login do servidor e senhas com o mesmo rótulo e usuário)" />
                </CheckBox>
            </StackPanel>

            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                <StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding Error, Converter={StaticResource TextToVis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                        <Button Style="{StaticResource Btn.Primary}" Content="Ler código" MinWidth="96" Click="Read_Click" Margin="0,0,8,0"
                                Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <Button Style="{StaticResource Btn.Secondary}" Content="Voltar" MinWidth="80" Click="Back_Click" Margin="0,0,8,0"
                                Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Btn.Primary}" Content="Importar" MinWidth="96" Click="Import_Click" Margin="0,0,8,0"
                                Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Btn.Secondary}" Content="Cancelar" MinWidth="80" IsCancel="True" Click="Cancel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
