<Window x:Class="GhstRDP.Views.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource WindowBase}"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Title="Digite o PIN">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource LayerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <StackPanel Margin="24,24,24,22">
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{StaticResource AccentTextBrush}" />
                <TextBlock Text="Digite o PIN do cofre" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBlock Text="Para ver ou copiar senhas." Style="{StaticResource Text.Caption}" FontSize="13" />
                <PasswordBox x:Name="PinBox" Margin="0,16,0,0" FontSize="16" MaxLength="12" KeyDown="PinBox_KeyDown"
                             AutomationProperties.Name="PIN" />
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                <UniformGrid Rows="1">
                    <Button x:Name="OkButton" Style="{StaticResource Btn.Primary}" Content="Desbloquear" Margin="0,0,4,0" Click="Ok_Click" />
                    <Button Style="{StaticResource Btn.Secondary}" Content="Cancelar" Margin="4,0,0,0" IsCancel="True" Click="Cancel_Click" />
                </UniformGrid>
            </Border>
        </StackPanel>
    </Border>
</Window>
