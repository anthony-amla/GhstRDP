<Application x:Class="GhstRDP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GhstRDP.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisHidden" UseHidden="True" />
            <conv:EnumToBoolConverter x:Key="EnumBool" />
            <conv:EnumToVisibilityConverter x:Key="EnumVis" />
            <conv:EnumToVisibilityConverter x:Key="EnumVisHidden" UseHidden="True" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:TextToVisibilityConverter x:Key="TextToVis" />
            <conv:InverseBoolConverter x:Key="InvertBool" />
            <conv:RatioConverter x:Key="Ratio" />
            <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVis" />
            <conv:IsZeroConverter x:Key="IsZero" />
            <conv:StatusToBrushConverter x:Key="StatusBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
