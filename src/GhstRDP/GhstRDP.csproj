<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GhstRDP</RootNamespace>
    <AssemblyName>GhstRDP</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Assets\ghst.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Ghst RDP</Product>
    <AssemblyTitle>Ghst RDP</AssemblyTitle>
    <Company>Ghst</Company>
    <Version>1.0.0</Version>
    <!-- Main próprio (Program.cs) para o Velopack rodar antes do WPF -->
    <StartupObject>GhstRDP.Program</StartupObject>
    <!-- Os interop COM gerados do mstscax.dll são .NET Framework; funcionam normalmente no .NET moderno. -->
    <!-- WFO0003: o DPI fica no manifest de propósito (app é WPF; o WinForms só hospeda o controle RDP). -->
    <NoWarn>$(NoWarn);MSB3274;MSB3275;NU1701;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF + WinForms juntos: evita ambiguidade de tipos (Button, Application, Color...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MSTSCLib">
      <HintPath>..\..\lib\MSTSCLib.dll</HintPath>
    </Reference>
    <Reference Include="AxMSTSCLib">
      <HintPath>..\..\lib\AxMSTSCLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Instalador (Setup.exe) e atualização automática via GitHub Releases -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ghst.png" />
    <Resource Include="Assets\ghst.ico" />
  </ItemGroup>

</Project>
