<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="C.Bg">#0D0D10</Color>
    <Color x:Key="C.Layer">#151518</Color>
    <Color x:Key="C.Surface">#1F1F23</Color>
    <Color x:Key="C.SurfaceHover">#27272C</Color>
    <Color x:Key="C.SurfacePressed">#1B1B1F</Color>
    <Color x:Key="C.Thumb">#2A2A30</Color>
    <Color x:Key="C.Control">#24242A</Color>
    <Color x:Key="C.ControlHover">#2B2B31</Color>
    <Color x:Key="C.Flyout">#24242A</Color>
    <Color x:Key="C.Border">#303036</Color>
    <Color x:Key="C.Divider">#2A2A30</Color>
    <Color x:Key="C.Text">#F2F2F4</Color>
    <Color x:Key="C.TextSecondary">#AAAAB3</Color>
    <Color x:Key="C.TextTertiary">#7D7D87</Color>
    <Color x:Key="C.Accent">#3B82F6</Color>
    <Color x:Key="C.AccentHover">#5B95F8</Color>
    <Color x:Key="C.AccentPressed">#2F6FD6</Color>
    <Color x:Key="C.AccentText">#8AB8FF</Color>
    <Color x:Key="C.Success">#22C55E</Color>
    <Color x:Key="C.Danger">#EF4444</Color>
    <Color x:Key="C.DangerText">#F87171</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource C.Bg}" />
    <SolidColorBrush x:Key="LayerBrush" Color="{StaticResource C.Layer}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource C.SurfaceHover}" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource C.SurfacePressed}" />
    <SolidColorBrush x:Key="ThumbBrush" Color="{StaticResource C.Thumb}" />
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource C.Control}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource C.ControlHover}" />
    <SolidColorBrush x:Key="FlyoutBrush" Color="{StaticResource C.Flyout}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource C.Divider}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource C.TextSecondary}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource C.TextTertiary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource C.AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource C.AccentPressed}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource C.AccentText}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource C.Success}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource C.DangerText}" />
    <SolidColorBrush x:Key="SessionBrush" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#FFFFFF" Opacity="0.07" />
    <SolidColorBrush x:Key="CaptionPressedBrush" Color="#FFFFFF" Opacity="0.04" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />

    <SolidColorBrush x:Key="NeutralChipBrush" Color="#2E2E35" />
    <SolidColorBrush x:Key="NeutralChipTextBrush" Color="#BDBDC6" />

    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#22C55E" Offset="0" />
        <GradientStop Color="#3B82F6" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
